# ---------------------------------------------------------------------------
# Secrets & credentials — NEVER commit
# ---------------------------------------------------------------------------
.env
.env.*
!.env.example
*.pem
*.key
id_rsa
id_ed25519
*.p12
credentials/
secrets/
.secrets/
.kaggle/
kaggle.json
.huggingface/
hf_token*
*.token
.netrc

# Claude Code local (machine-specific) settings & MCP auth
.claude/settings.local.json
.claude/.mcp.local.json
.mcp.local.json
.claude/mcp-auth*
.claude/*.local.*

# Agent/skill machinery installed per-machine, not part of the project. The six
# project skills under .claude/skills/ that ARE part of it are tracked by name.
.agents/
skills-lock.json
.claude/skills/notebooklm

# ---------------------------------------------------------------------------
# Python environments & caches
# ---------------------------------------------------------------------------
.venv/
venv/
env/
__pycache__/
*.py[cod]
*.egg-info/
.eggs/
build/
dist/
.pytest_cache/
.ruff_cache/
.mypy_cache/
.ipynb_checkpoints/
.coverage
.coverage.*
htmlcov/
.cache/
.hypothesis/

# uv keeps uv.lock TRACKED (reproducibility). Do not ignore uv.lock.

# ---------------------------------------------------------------------------
# Data — raw & processed datasets must NOT be committed
# ---------------------------------------------------------------------------
data/raw/*
data/interim/*
data/processed/*
!data/raw/.gitkeep
!data/interim/.gitkeep
!data/processed/.gitkeep
*.parquet
*.arrow
*.feather
*.csv
*.tsv
*.npz
*.npy
*.h5
*.hdf5
*.duckdb
*.sqlite
*.zip
*.7z

# ---------------------------------------------------------------------------
# Model checkpoints, weights & experiment artifacts
# ---------------------------------------------------------------------------
artifacts/*
!artifacts/.gitkeep
*.ckpt
*.pt
*.pth
*.safetensors
*.onnx
*.bin
checkpoints/
wandb/
mlruns/
outputs/

# ---------------------------------------------------------------------------
# Logs & reports (keep dirs, ignore heavy contents)
# ---------------------------------------------------------------------------
logs/*
!logs/.gitkeep
*.log
# reports/ holds regenerable run artifacts (baseline/leakage/data-audit outputs
# with per-run timestamps + git fingerprints). Curated reports live in docs/.
reports/*
!reports/.gitkeep

# ---------------------------------------------------------------------------
# HF / model caches
# ---------------------------------------------------------------------------
.hf_cache/
transformers_cache/
hf_home/

# ---------------------------------------------------------------------------
# OS / editor cruft
# ---------------------------------------------------------------------------
.DS_Store
Thumbs.db
*.swp
.idea/
.vscode/

# Phase 11A: isolated TS-RAG clone, assets, venv (never commit)
external/

# ---------------------------------------------------------------------------
# Manuscript under anonymous review — keep local until 2026-11-01
# ---------------------------------------------------------------------------
# Rationale is in the folder's own local notes file, which is not tracked.
submission/

# ---------------------------------------------------------------------------
# LaTeX build artifacts
# ---------------------------------------------------------------------------
# Both manuscript folders build in place, so the intermediates land next to the
# sources. main.log is already covered by the *.log rule above. The compiled
# main.pdf of the tracked manuscript IS committed: it is the deliverable.
*.aux
*.bbl
*.blg
*.out
*.toc
*.lof
*.lot
*.bcf
*.run.xml
*.synctex.gz
*.fls
*.fdb_latexmk
*.dvi
*.spl
texput.*
