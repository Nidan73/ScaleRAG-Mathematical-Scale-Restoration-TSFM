    <mxCell id="N1" value="1.  SCALE NORMALIZATION&#10;(query)&#10;&#10;μ_q , σ_q  from the context&#10;q* = ( x − μ_q ) / ( σ_q + ε )" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#e8f1fc;strokeColor=#2a78d6;strokeWidth=1.5;fontSize=11.5;fontColor=#0b0b0b;verticalAlign=middle;" vertex="1" parent="1">
