      <mxGeometry x="255" y="528" width="220" height="104" as="geometry" />
    </mxCell>
    <mxCell id="IDX" value="2.  EXACT k-NN SEARCH&#10;in the scale-invariant space&#10;&#10;FAISS IndexFlatL2 (CPU);&#10;batched-GPU exact search&#10;for the 30,490-series M5 panel&#10;&#10;L2 metric  ·  k = 20&#10;category filter" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#e8f1fc;strokeColor=#2a78d6;strokeWidth=1.5;fontSize=11.5;fontColor=#0b0b0b;verticalAlign=middle;" vertex="1" parent="1">
