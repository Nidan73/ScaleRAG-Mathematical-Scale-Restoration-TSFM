    <mxCell id="B1" value="❄   FROZEN TSFM BACKBONE&#10;Chronos-2 (M5)  ·  Chronos-Bolt (ETTm2)&#10;&#10;zero-shot forecast   y_TSFM ∈ ℝ^H&#10;0 trainable parameters" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#fdece4;strokeColor=#eb6834;strokeWidth=2;fontSize=11.5;fontColor=#0b0b0b;verticalAlign=middle;" vertex="1" parent="1">
      <mxGeometry x="1240" y="118" width="300" height="122" as="geometry" />
    </mxCell>
    <mxCell id="FUSE" value="4.  FUSION&#10;&#10;y = ( 1 − w ) · y_TSFM&#10;+  w · y_restored" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#e8f1fc;strokeColor=#2a78d6;strokeWidth=2;fontSize=12.5;fontColor=#0b0b0b;verticalAlign=middle;" vertex="1" parent="1">
