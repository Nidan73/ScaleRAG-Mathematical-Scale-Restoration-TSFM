    <mxCell id="GATE" value="LEARNED GATE     w = g( φ )&#10;sparse regime  (M5)&#10;&#10;LightGBM, fit on training origins only&#10;&#10;φ  =  nn-distance  ·  retrieval disagreement&#10;intermittency  ·  log-volume&#10;backbone uncertainty  ·  scale spread&#10;&#10;the only trained component in the system" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#ece9f6;strokeColor=#4a3aa7;strokeWidth=2;fontSize=11;fontColor=#0b0b0b;verticalAlign=middle;" vertex="1" parent="1">
