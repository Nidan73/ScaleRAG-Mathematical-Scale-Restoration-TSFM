      <mxGeometry x="805" y="400" width="150" height="80" as="geometry" />
    </mxCell>
    <mxCell id="RES" value="3.  EXPLICIT SCALE RESTORATION&#10;&#10;y_restored = y* · σ_q + μ_q&#10;&#10;mean over the k candidates" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#e8f1fc;strokeColor=#2a78d6;strokeWidth=2;fontSize=11.5;fontColor=#0b0b0b;verticalAlign=middle;" vertex="1" parent="1">
